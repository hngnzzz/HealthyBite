# Docker compose MariaDB settings.
# Backend inside Docker uses DB_HOST=database:3306.
# Backend outside Docker uses ConnectionStrings__DefaultConnection below via 127.0.0.1:3307.
DB_HOST=database
DB_PORT=3306
DB_PUBLIC_PORT=3307
DB_NAME=healthymeal
DB_USER=healthymeal
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD
DB_ROOT_PASSWORD=YOUR_LOCAL_ROOT_PASSWORD
BACKEND_PORT=5299
FRONTEND_DEV_PORT=5173

# Optional full backend connection string for dotnet run
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3307;Database=healthymeal;Uid=healthymeal;Pwd=YOUR_LOCAL_DB_PASSWORD;SslMode=None;AllowPublicKeyRetrieval=True;Connection Timeout=3;Default Command Timeout=5;
